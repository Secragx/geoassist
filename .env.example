# GeoAssist — plantilla de variables de entorno.
#
# Copiar a `.env` y completar los secretos. En producción (`APP_ENV=production`)
# el servicio es fail-closed: no arranca sin TEAMS_SECURITY_TOKEN, LLM_API_KEY,
# LLM_DATA_POLICY y las rutas de modelos.

# --- Entorno -----------------------------------------------------------------
APP_ENV=development

# --- Microsoft Teams ---------------------------------------------------------
TEAMS_SECURITY_TOKEN=
TEAMS_BOT_NAME=GeoAssist

# --- Cliente LLM compatible con OpenAI ---------------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=2500
# external_approved | on_prem_only (obligatorio en producción)
LLM_DATA_POLICY=
# Lista separada por comas o JSON; obligatoria para on_prem_only.
LLM_ALLOWED_HOSTS=

# --- Modelos ONNX ------------------------------------------------------------
EMBEDDING_MODEL_PATH=/app/models/bge-m3-int8
RERANK_MODEL_PATH=/app/models/mmarco-mMiniLMv2-L12-H384-v1-int8
RERANK_MIN_SCORE=0.0
# Artefacto de build: URL y SHA-256 de geoassist-models-<versión>.tar.zst.
MODELS_ARTIFACT_URL=
MODELS_ARTIFACT_SHA256=

# --- Volúmenes y rutas -------------------------------------------------------
DATA_DIR=/data
MANUALS_DIR=/manuals
MANUALS_ROOT_REL=data_source/manuales
ASSETS_ROOT_REL=data_source/assets

# --- Sesiones y límites ------------------------------------------------------
SESSION_TTL_MINUTES=120
RATE_LIMIT_PER_MINUTE=6

# --- Diagnóstico y logs ------------------------------------------------------
DEBUG_RETRIEVAL=false
DEBUG_TOKEN=
LOG_QUESTION_TEXT=false
LOG_LEVEL=INFO

# --- Sincronización de manuales ---------------------------------------------
SYNC_REPO_URL=git@github.com:Secragx/manuales_soporte_L2.git
SYNC_GIT_TOKEN=

# --- Compose: exposición y perfiles -----------------------------------------
# Estas variables las consume Docker Compose, no la aplicación. `Settings`
# ignora las claves desconocidas del archivo `.env`, así que copiar esta
# plantilla no rompe el arranque local.
# Dominio público servido por Caddy en el perfil `prod`.
GEOASSIST_DOMAIN=localhost
# Token del túnel de desarrollo (perfil `dev`).
NGROK_AUTHTOKEN=
# Perfiles a activar por defecto: vacío (solo api), prod (caddy) o dev (ngrok).
COMPOSE_PROFILES=
